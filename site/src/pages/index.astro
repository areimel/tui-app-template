---
import SiteLayout from "../layouts/SiteLayout.astro";
import TerminalPreview from "../components/TerminalPreview.astro";
import CodeBlock from "../components/CodeBlock.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../config/site.config";
import {
  HERO,
  FEATURES,
  EXAMPLES,
  STEPS,
  PLATFORM_SECTION,
  FINAL_CTA,
  type Link,
} from "../data/home";
import { href } from "../lib/urls";
import "../styles/home.css";
import "../styles/home-responsive.css";

/** Site paths get the base prefix; in-page anchors and absolute URLs pass through. */
const resolve = (path: string, external = false) =>
  external || path.startsWith("#") || /^https?:/.test(path) ? path : href(path);
const linkProps = (link: Link) => ({
  href: resolve(link.path, link.external),
  label: link.label,
});
---

<SiteLayout
  title={`${SITE_NAME}: ${HERO.tagline}`}
  description={SITE_DESCRIPTION}
>
  <div class="container home">
    <section class="home-intro" aria-labelledby="home-heading">
      <div class="home-statusline eyebrow">
        <span><i aria-hidden="true"></i> {HERO.eyebrow}</span>
        <span>{HERO.license}</span>
      </div>
      <div class="home-heading-row">
        <h1 id="home-heading">
          {HERO.titleLines.map((line) => <span>{line}</span>)}<span
            class="heading-cursor"
            aria-hidden="true">_</span
          >
        </h1>
        <div class="home-intro-copy">
          <p class="home-tagline">{HERO.tagline}</p>
          <p>{HERO.intro}</p>
          <div class="home-links">
            <a class="button button-primary" href={resolve(HERO.primary.path)}
              >{HERO.primary.label} <span aria-hidden="true">↗</span></a
            >
            <ArrowLink {...linkProps(HERO.secondary)} />
          </div>
          <p class="home-requirement">{HERO.requirement}</p>
        </div>
      </div>
      <div class="home-hero-install">
        <CodeBlock code={HERO.install.code} label={HERO.install.label} />
      </div>
    </section>

    <TerminalPreview />

    <section class="home-section" aria-labelledby="features-heading">
      <SectionHeading
        eyebrow={FEATURES.eyebrow}
        heading={FEATURES.heading}
        id="features-heading"
      />
      <div class="home-grid">
        {
          FEATURES.items.map((item) => (
            <FeatureCard
              title={item.title}
              text={item.text}
              glyph={item.glyph}
              {...(item.path ? { href: resolve(item.path) } : {})}
              {...(item.linkLabel ? { linkLabel: item.linkLabel } : {})}
            />
          ))
        }
      </div>
    </section>

    <section
      class="home-section"
      id="examples"
      aria-labelledby="examples-heading"
    >
      <SectionHeading
        eyebrow={EXAMPLES.eyebrow}
        heading={EXAMPLES.heading}
        id="examples-heading"
      />
      <p class="home-lede">{EXAMPLES.intro}</p>
      <div class="home-grid">
        {
          EXAMPLES.items.map((item) => (
            <FeatureCard
              title={item.title}
              text={item.text}
              glyph={item.glyph}
              href={resolve(item.path ?? "")}
              {...(item.linkLabel ? { linkLabel: item.linkLabel } : {})}
            />
          ))
        }
      </div>
    </section>

    <section class="home-section home-steps" aria-labelledby="steps-heading">
      <div class="home-steps-copy">
        <SectionHeading
          eyebrow={STEPS.eyebrow}
          heading={STEPS.heading}
          id="steps-heading"
        />
        <p class="home-lede">{STEPS.intro}</p>
        <ArrowLink {...linkProps(STEPS.more)} />
      </div>
      <div class="home-steps-list">
        <ol>
          {
            STEPS.items.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                {step.code && <CodeBlock code={step.code} />}
              </li>
            ))
          }
        </ol>
        <div class="home-try">
          <p>{STEPS.tryIt.label}</p>
          <CodeBlock code={STEPS.tryIt.code} label="Run with npx" />
          <p class="home-note">{STEPS.tryIt.note}</p>
        </div>
      </div>
    </section>

    <section
      class="home-section home-platforms"
      aria-labelledby="platform-heading"
    >
      <SectionHeading
        eyebrow={PLATFORM_SECTION.eyebrow}
        heading={PLATFORM_SECTION.heading}
        id="platform-heading"
      />
      <div class="platform-list">
        {
          PLATFORM_SECTION.items.map((item) => (
            <div>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
        <ArrowLink {...linkProps(PLATFORM_SECTION.link)} />
      </div>
    </section>

    <section class="home-final" aria-labelledby="final-heading">
      <SectionHeading
        eyebrow={FINAL_CTA.eyebrow}
        heading={FINAL_CTA.heading}
        id="final-heading"
      />
      <div class="home-links">
        <a class="button button-primary" href={resolve(FINAL_CTA.primary.path)}
          >{FINAL_CTA.primary.label} <span aria-hidden="true">↗</span></a
        >
        <ArrowLink {...linkProps(FINAL_CTA.secondary)} />
      </div>
    </section>
  </div>
</SiteLayout>
