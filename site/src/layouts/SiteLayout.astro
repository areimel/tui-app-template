---
import "../styles/global.css";
import { href } from "../lib/urls";
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  REPO_URL,
  AUTHOR,
  LICENSE_LABEL,
  THEME_COLOR,
  THEME_STORAGE_KEY,
} from "../config/site.config";
interface Props {
  title: string;
  description?: string;
}
const { title, description = SITE_DESCRIPTION } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const docsActive = Astro.url.pathname.startsWith(href("docs/"));
---

<html lang="en" data-theme="kojima" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={THEME_COLOR} />
    <title>{title === SITE_NAME ? title : `${title} | ${SITE_NAME}`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(href("og-image.png"), Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY }}>
      try {
        document.documentElement.classList.toggle(
          "dark",
          localStorage.getItem(themeKey) !== "light",
        );
      } catch {
        /* Default to the server-rendered dark palette. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href={href("")} aria-label={`${SITE_NAME} home`}
          ><span aria-hidden="true">&gt;_</span>{SITE_NAME}</a
        >
        <nav class="site-nav" aria-label="Main navigation">
          <a href={href("docs/")} aria-current={docsActive ? "true" : undefined}
            >Docs</a
          >
          <a href={REPO_URL}>GitHub <span aria-hidden="true">↗</span></a>
          <button class="theme-toggle" hidden aria-label="Switch to light mode"
            >Light mode</button
          >
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>{SITE_NAME} / made by <a href={AUTHOR.url}>{AUTHOR.name}</a></span
        >
        <div class="footer-links">
          <a href={href("docs/")}>Documentation</a><a href={REPO_URL}
            >Source ↗</a
          ><span>{LICENSE_LABEL}</span>
        </div>
      </div>
    </footer>
    <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY }}>
      const button = document.querySelector(".theme-toggle");
      if (button) {
        const update = () => {
          const next = document.documentElement.classList.contains("dark")
            ? "light"
            : "dark";
          button.textContent = `${next === "light" ? "Light" : "Dark"} mode`;
          button.setAttribute("aria-label", `Switch to ${next} mode`);
        };
        button.hidden = false;
        update();
        button.addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          try {
            localStorage.setItem(themeKey, dark ? "dark" : "light");
          } catch {
            /* Storage is optional. */
          }
          update();
        });
      }
    </script>
  </body>
</html>
