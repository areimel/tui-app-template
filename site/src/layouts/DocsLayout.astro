---
import SiteLayout from "./SiteLayout.astro";
import { href } from "../lib/urls";
import { getDocsNav } from "../lib/docs-nav";
import {
  SITE_NAME,
  APP,
  REPO_URL,
  ISSUES_URL,
  README_URL,
} from "../config/site.config";
import "../styles/docs.css";

interface Props {
  frontmatter: { title: string; description: string };
  headings: { depth: number; slug: string; text: string }[];
}
const { frontmatter, headings: pageHeadings } = Astro.props;
const groups = await getDocsNav();
const headings = pageHeadings.filter((heading) => heading.depth === 2);
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<SiteLayout
  title={`${frontmatter.title} | Docs`}
  description={frontmatter.description}
>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <p class="docs-label">MANUAL / {APP.command}</p>
      <nav aria-label="Documentation">
        {
          groups.map((group) => (
            <section class="docs-group">
              <h2 class="docs-label">{group.section.toUpperCase()}</h2>
              {group.items.map((item) => (
                <a
                  href={href(item.path)}
                  aria-current={
                    currentPath === href(item.path).replace(/\/$/, "")
                      ? "page"
                      : undefined
                  }
                >
                  {item.title}
                </a>
              ))}
            </section>
          ))
        }
      </nav>
      <a class="docs-source" href={REPO_URL}>View source ↗</a>
    </aside>
    <article class="docs-article">
      <header class="docs-header">
        <p class="docs-label">{SITE_NAME} / DOCUMENTATION</p>
        <h1>{frontmatter.title}</h1>
        {
          frontmatter.description && (
            <p class="docs-description">{frontmatter.description}</p>
          )
        }
      </header>
      {
        headings.length > 0 && (
          <nav class="docs-contents" aria-label="On this page">
            <span class="docs-label">ON THIS PAGE</span>
            <ul>
              {headings.map(({ slug, text }) => (
                <li>
                  <a href={`#${slug}`}>{text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <div class="docs-prose"><slot /></div>
      <footer class="docs-footer">
        Source of truth: the project's <a href={README_URL}>README and source</a
        >. Found an issue? <a href={ISSUES_URL}>Open an issue ↗</a>
      </footer>
    </article>
  </div>
</SiteLayout>
