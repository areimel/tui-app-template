---
import "../styles/terminal.css";
import "../styles/terminal-responsive.css";
import { APP, PREVIEW_STORAGE_KEY } from "../config/site.config";
import {
  HEADING_LINES,
  PREVIEW_APPS,
  PREVIEW_CURSOR,
  PREVIEW_KEYS,
  PREVIEW_LABELS,
  PREVIEW_PALETTES,
  PREVIEW_TITLEBAR,
} from "../data/preview";

const [defaultPalette] = PREVIEW_PALETTES;
/** Palette colours from the site config become CSS custom properties, one rule per palette. */
const paletteCss = PREVIEW_PALETTES.map(
  (p) =>
    `.terminal-preview[data-palette="${p.id}"]{--terminal-accent:${p.accent};--terminal-text:${p.text};--terminal-muted:${p.muted};--terminal-border:${p.border};--terminal-bg:${p.bg}}`,
).join("");
---

<style is:global set:html={paletteCss}></style>
<div class="terminal-workspace">
  <div class="preview-toolbar">
    <span class="eyebrow">{PREVIEW_LABELS.eyebrow}</span>
    <div
      class="preview-themes"
      role="group"
      aria-label={PREVIEW_LABELS.groupLabel}
    >
      <span>{PREVIEW_LABELS.groupTitle}</span>
      {
        PREVIEW_PALETTES.map((p) => (
          <button
            type="button"
            data-preview-theme={p.id}
            data-label={p.label}
            aria-label={p.label}
            aria-pressed={p.id === defaultPalette.id ? "true" : "false"}
          >
            {p.label}
          </button>
        ))
      }
    </div>
  </div>
  <figure
    class="terminal-preview"
    data-terminal-preview
    data-storage-key={PREVIEW_STORAGE_KEY}
    data-palette={defaultPalette.id}
    aria-label={PREVIEW_LABELS.figureLabel}
  >
    <div class="terminal-titlebar">
      <span>{PREVIEW_TITLEBAR.prompt} <b>❯ {PREVIEW_TITLEBAR.command}</b></span>
      <span>{PREVIEW_TITLEBAR.size}</span>
    </div>
    <div class="terminal-screen">
      <div class="terminal-frame">
        <span class="frame-edge frame-top">{APP.displayName}</span>
        <pre
          class="terminal-art"
          aria-hidden="true">{HEADING_LINES.join("\n")}</pre>
        <p class="terminal-tagline">{APP.tagline}</p>
        <ul class="terminal-menu" aria-label={PREVIEW_LABELS.menuLabel}>
          {
            PREVIEW_APPS.map((app, index) => (
              <li class:list={[{ "is-selected": index === PREVIEW_CURSOR }]}>
                <span class="menu-cursor" aria-hidden="true">
                  {index === PREVIEW_CURSOR ? "❯" : ""}
                </span>
                <span class="menu-number">{index + 1}</span>
                <span class="menu-glyph" aria-hidden="true">
                  {app.glyph}
                </span>
                <span class="menu-title">{app.title}</span>
                <span class="menu-desc">{app.description}</span>
              </li>
            ))
          }
        </ul>
        <div class="frame-edge frame-bottom">
          {PREVIEW_KEYS.map((key) => <span>{key}</span>)}
        </div>
      </div>
    </div>
    <figcaption>
      <span>{PREVIEW_LABELS.caption}</span>
      <span data-preview-caption
        >{PREVIEW_LABELS.captionPalette(defaultPalette.label)}</span
      >
    </figcaption>
  </figure>
</div>

<script>
  const preview = document.querySelector<HTMLElement>(
    "[data-terminal-preview]",
  );
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-preview-theme]",
  );
  const storageKey = preview?.dataset.storageKey ?? "";
  function selectTheme(theme: string) {
    const chosen = [...buttons].find((b) => b.dataset.previewTheme === theme);
    if (!preview || !chosen) return;
    preview.dataset.palette = theme;
    buttons.forEach((button) =>
      button.setAttribute("aria-pressed", String(button === chosen)),
    );
    const caption = preview.querySelector("[data-preview-caption]");
    if (caption) caption.textContent = `${chosen.dataset.label ?? theme} theme`;
  }
  try {
    const saved = localStorage.getItem(storageKey);
    if (saved) selectTheme(saved);
  } catch {
    /* Storage is optional. */
  }
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const theme = button.dataset.previewTheme ?? "";
      selectTheme(theme);
      try {
        localStorage.setItem(storageKey, theme);
      } catch {
        /* Storage is optional. */
      }
    }),
  );
</script>
