---
import { COPY_LABEL, COPY_ARIA_LABEL } from "../config/site.config";
interface Props {
  code: string;
  label?: string;
  /** Visible copy button text. */
  copyLabel?: string;
  /** Accessible name of the copy button. */
  copyAriaLabel?: string;
}
const {
  code,
  label = "terminal",
  copyLabel = COPY_LABEL,
  copyAriaLabel = COPY_ARIA_LABEL,
} = Astro.props;
---

<div class="code-block">
  <div class="code-bar">
    <span>{label}</span><button
      class="copy-command"
      aria-label={copyAriaLabel}
      hidden>{copyLabel}</button
    ><span class="copy-status" role="status"></span>
  </div>
  <pre tabindex="0"><code>{code}</code></pre>
</div>
<script>
  const STATUS_CLEAR_MS = 2000;
  document.querySelectorAll<HTMLElement>(".code-block").forEach((block) => {
    const button = block.querySelector<HTMLButtonElement>(".copy-command");
    const status = block.querySelector<HTMLElement>(".copy-status");
    if (!button || !status || !navigator.clipboard) return;
    let timer: number | undefined;
    const say = (message: string) => {
      window.clearTimeout(timer);
      status.textContent = message;
      timer = window.setTimeout(() => {
        status.textContent = "";
      }, STATUS_CLEAR_MS);
    };
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(
          block.querySelector("code")?.textContent ?? "",
        );
        say("Copied");
      } catch {
        say("Select and copy the command below.");
      }
    });
  });
</script>
